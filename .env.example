# Переменные окружения для запуска «по-настоящему» (npm start / Docker).
# Скопируйте в .env и подставьте свои значения; .env в репозиторий не попадает.

# Порт HTTP-сервера (на хостинге обычно задаётся платформой)
PORT=8787

# production включает предупреждения и строгие настройки
NODE_ENV=production

# Секрет подписи JWT. Обязателен в проде: иначе токены можно подделать.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Папка с базой и logins.csv. На хостинге — смонтированный том.
DATA_DIR=./server/data

# Часовой пояс столовой в минутах от UTC (540 = UTC+9)
TZ_OFFSET_MIN=540

# Дедлайн выбора блюд и жёсткий контроль времени
CHOICE_DEADLINE=08:15
CHOICE_ENFORCE_DEADLINE=true

# Домены фронта через запятую — нужен, только если фронт на другом домене
CORS_ORIGIN=

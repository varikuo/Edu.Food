# Зависимости и сборка
node_modules/
dist/

# Локальный сертификат для камеры на телефоне (генерируется npm run cert)
.certs/

# Логи запуска
*.log

# База создаётся скриптом npm run seed
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal

# Логины и пароли учеников выдаются в школе, в репозиторий не попадают
server/data/logins.csv

# Секреты локального запуска (образец — .env.example)
.env

# Временные файлы проверок и запуска
.tmp-*

# ОС и редакторы
.DS_Store
Thumbs.db
.vscode/
